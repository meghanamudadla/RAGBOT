# Backend environment variables
# Copy this file to .env and fill in your values

# --- Database ---
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
POSTGRES_DSN=postgresql+asyncpg://postgres:yourpassword@localhost:5432/docapp

# --- Security ---
JWT_SECRET_KEY=change_me_to_a_long_random_secret_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Vector Store ---
CHROMA_PATH=./chroma

# --- LLM ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Google OAuth ("Continue with Google") ---
# 1. Go to https://console.cloud.google.com/ → create a project (or pick one)
# 2. "APIs & Services" → "OAuth consent screen" → External → fill app name + your email
# 3. "APIs & Services" → "Credentials" → "Create Credentials" → "OAuth client ID" → Web app
# 4. Authorized redirect URI must be exactly: http://localhost:8000/api/v1/auth/google/callback
# 5. Copy the Client ID + Client Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# --- App ---
APP_NAME=AI Document Search
DEBUG=false